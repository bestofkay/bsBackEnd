{
  "name": "bs-app",
  "version": "0.1.0",
  "description": "Production-grade Bank Statement Extraction Service",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:frontend": "node scripts/build-frontend.mjs",
    "start": "node dist/index.js",
    "start:prod": "node scripts/railway-start.mjs",
    "start:api": "node scripts/railway-start.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:regression": "vitest run",
    "test:archive": "node scripts/e2e-mysql-archive.mjs",
    "audit:deps": "npm audit --omit=dev",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "bank-statement",
    "extraction",
    "fintech"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@napi-rs/canvas": "^0.1.65",
    "@prisma/client": "6.15.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "helmet": "8.0.0",
    "morgan": "1.10.0",
    "multer": "1.4.5-lts.2",
    "pdfjs-dist": "^4.10.38",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "sharp": "^0.33.5",
    "tesseract.js": "^5.1.1",
    "xlsx": "^0.18.5",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "9.22.0",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/morgan": "1.9.9",
    "@types/multer": "1.4.12",
    "@types/node": "22.13.10",
    "@types/supertest": "6.0.2",
    "@vitest/coverage-v8": "^3.0.8",
    "eslint": "9.22.0",
    "pino-pretty": "13.0.0",
    "prisma": "6.15.0",
    "supertest": "7.0.0",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "typescript-eslint": "8.26.1",
    "vitest": "3.0.8"
  }
}
